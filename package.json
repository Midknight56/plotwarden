{
  "name": "plotwarden",
  "version": "0.1.0",
  "private": true,
  "description": "Plotwarden keeps plot registers on the keeper's own device.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "host:build": "vite build --config tests/host/vite.config.ts",
    "host:preview": "vite preview --config tests/host/vite.config.ts",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test:unit": "vitest run tests/unit",
    "test:properties": "vitest run tests/properties",
    "test:conformance": "vitest run tests/conformance",
    "test:oracle": "vitest run tests/oracle",
    "test:browser": "playwright test --pass-with-no-tests",
    "check:imports": "node scripts/check-imports.mjs",
    "export:exchange": "node scripts/export-exchange.mjs",
    "create:app": "node scripts/create-app.mjs",
    "build:inspector": "vite build --config tools/inspector/vite.config.ts && vite build --config tools/inspector/vite.config.ts --mode cli",
    "check:changed": "npm run typecheck && node scripts/check-imports.mjs && node scripts/changed-tests.mjs --git",
    "church:build": "vite build --config apps/churchyard-register/vite.config.ts",
    "church:preview": "vite preview --config apps/churchyard-register/vite.config.ts",
    "church:dev": "vite --config apps/churchyard-register/vite.config.ts",
    "allot:build": "vite build --config apps/allotment-register/vite.config.ts",
    "allot:preview": "vite preview --config apps/allotment-register/vite.config.ts",
    "allot:dev": "vite --config apps/allotment-register/vite.config.ts",
    "market:build": "vite build --config examples/market/vite.config.ts",
    "market:preview": "vite preview --config examples/market/vite.config.ts",
    "market:dev": "vite --config examples/market/vite.config.ts"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "fake-indexeddb": "6.2.8",
    "fast-check": "4.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
